    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.10",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "shadcn": "^3.4.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
