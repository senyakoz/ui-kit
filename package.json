{
  "name": "prometey-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
